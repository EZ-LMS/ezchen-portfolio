---
import { experience } from "../data/experience";
---
<section id="experience" class="section border-t border-line">
  <div class="page-container">
    <p class="eyebrow mb-4">Experience</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-10">
      Where I've shipped.
    </h2>

    <ol class="relative border-l border-line ml-2">
      {experience.map((item) => (
        <li class="relative pl-8 pb-10 last:pb-0">
          <span
            class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full"
            style="background-color: var(--color-dust-purple);"
            aria-hidden="true"
          ></span>

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-lg font-medium text-ink">{item.role}</h3>
            <span class="text-ink-muted">·</span>
            <p class="text-base text-ink-muted">{item.company}</p>
            <p class="text-sm text-ink-faint font-mono ml-auto">
              {item.start} — {item.end}
            </p>
          </div>

          <p class="mt-1 text-sm text-ink-faint">{item.location}</p>

          {item.blurb && (
            <p class="mt-3 text-sm md:text-base leading-relaxed text-ink-muted max-w-3xl">
              {item.blurb}
            </p>
          )}

          {item.bullets && item.bullets.length > 0 && (
            <ul class="mt-3 space-y-1.5 max-w-3xl">
              {item.bullets.map((b) => (
                <li class="text-sm md:text-base text-ink-muted leading-relaxed flex gap-2">
                  <span class="text-ink-faint" aria-hidden="true">—</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
