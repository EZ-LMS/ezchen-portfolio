---
import { site } from "../data/site";
---
<header
  class="sticky top-0 z-40 border-b border-line/60 backdrop-blur-md"
  style="background-color: color-mix(in srgb, var(--color-bg) 78%, transparent);"
>
  <nav class="page-container flex h-14 items-center justify-between">
    <a
      href="#top"
      class="text-sm font-medium tracking-tight text-ink hover:text-ink/80 transition-colors"
    >
      {site.name}
    </a>
    <ul class="flex items-center gap-1 sm:gap-2 text-sm">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="px-2 py-1 rounded-md text-ink-muted hover:text-ink hover:bg-surface-2 transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
