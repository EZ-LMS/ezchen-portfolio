---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const all = await getCollection("projects", ({ data }) => data.featured);
const projects = all.sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="py-12 md:py-16 border-t border-line">
  <div class="page-container">
    <p class="eyebrow mb-6">Vibe Code Project</p>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <ProjectCard
          title={p.data.title}
          description={p.data.description}
          year={p.data.year}
          tech={p.data.tech}
          demoUrl={p.data.demoUrl}
          demoNote={p.data.demoNote}
          repoUrl={p.data.repoUrl}
          thumbnail={p.data.thumbnail}
        />
      ))}
    </div>
  </div>
</section>
