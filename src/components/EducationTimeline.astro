---
import { education } from "../data/education";
---
<section id="education" class="section border-t border-line">
  <div class="page-container">
    <p class="eyebrow mb-4">Education</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-10">
      Where I've studied.
    </h2>

    <ol class="relative border-l border-line ml-2">
      {education.map((item) => (
        <li class="relative pl-8 pb-10 last:pb-0">
          <span
            class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full"
            style="background-color: var(--color-dust-blue);"
            aria-hidden="true"
          ></span>

          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="text-lg font-medium text-ink">{item.school}</h3>
            <p class="text-sm text-ink-faint font-mono ml-auto">
              {item.start} — {item.end}
            </p>
          </div>

          <p class="mt-1 text-base text-ink-muted">
            {item.degree} · <span class="text-ink-faint">{item.location}</span>
          </p>

          {item.note && (
            <p class="mt-2 text-sm text-ink-muted max-w-3xl">{item.note}</p>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
