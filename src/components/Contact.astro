---
import { site } from "../data/site";

const contacts = [
  {
    label: "Email",
    value: site.links.email,
    href: `mailto:${site.links.email}`,
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/ez-chen",
    href: site.links.linkedin,
  },
  {
    label: "GitHub",
    value: "github.com/EZ-LMS",
    href: site.links.github,
  },
];
---
<section id="contact" class="section border-t border-line">
  <div class="page-container">
    <p class="eyebrow mb-4">Contact</p>
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-3">
      Say hi.
    </h2>
    <p class="text-base text-ink-muted max-w-2xl mb-10">
      I love hearing from PMs, builders, baseball nerds, and anyone with a good
      product story. The fastest way to reach me is email.
    </p>

    <ul class="divide-y divide-line border-y border-line">
      {contacts.map((c) => (
        <li>
          <a
            href={c.href}
            target={c.href.startsWith("mailto:") ? undefined : "_blank"}
            rel={c.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            class="group flex items-center justify-between gap-4 py-5 transition-colors hover:bg-surface-2 -mx-3 px-3 rounded-md"
          >
            <div class="flex flex-col">
              <span class="text-xs font-mono uppercase tracking-wider text-ink-faint">
                {c.label}
              </span>
              <span class="text-base md:text-lg text-ink">{c.value}</span>
            </div>
            <span
              aria-hidden="true"
              class="text-ink-faint transition-transform group-hover:translate-x-1 group-hover:text-ink"
            >
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
