---
import { site } from "../data/site";

const contacts = [
  { label: "Email", value: site.links.email, href: `mailto:${site.links.email}` },
  { label: "LinkedIn", value: "linkedin.com/in/ez-chen", href: site.links.linkedin },
  { label: "GitHub", value: "github.com/EZ-LMS", href: site.links.github },
];
---
<section id="contact" class="py-12 md:py-16 border-t border-line">
  <div class="page-container">
    <div class="grid gap-8 md:grid-cols-[1fr_2fr] items-start">
      <div>
        <p class="eyebrow mb-3">Contact</p>
        <h2 class="text-xl md:text-2xl font-semibold tracking-tight leading-tight">
          Always up for a coffee chat.
        </h2>
      </div>
      <ul class="grid gap-2">
        {contacts.map((c) => (
          <li>
            <a
              href={c.href}
              target={c.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={c.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              class="group flex items-center justify-between gap-4 py-2.5 px-3 -mx-3 rounded-md hover:bg-surface-2 transition-colors"
            >
              <div class="flex items-baseline gap-3 min-w-0">
                <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-ink-faint w-16 shrink-0">
                  {c.label}
                </span>
                <span class="text-sm md:text-base text-ink truncate">{c.value}</span>
              </div>
              <span aria-hidden="true" class="text-ink-faint shrink-0 transition-transform group-hover:translate-x-1 group-hover:text-ink">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
