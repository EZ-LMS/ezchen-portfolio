---
import { site } from "../data/site";
---
<section id="about" class="section border-t border-line">
  <div class="page-container grid gap-12 md:grid-cols-[1.3fr_1fr] md:gap-16 items-start">
    <div>
      <p class="eyebrow mb-4">About</p>
      <div class="space-y-5 text-base md:text-lg leading-relaxed text-ink">
        {site.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <figure class="relative">
      <div class="overflow-hidden rounded-2xl border border-line bg-surface-2 aspect-[4/3]">
        <img
          src="/images/about-baseball.svg"
          alt="EZ at bat for National Taiwan University, jersey #34"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <figcaption class="mt-3 text-xs text-ink-faint">
        NTU Varsity Baseball · still showing up to amateur leagues in the Bay
      </figcaption>
    </figure>
  </div>
</section>
