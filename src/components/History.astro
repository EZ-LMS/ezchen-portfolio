---
import { experience } from "../data/experience";
import { education } from "../data/education";
---
<section id="history" class="py-12 md:py-16 border-t border-line">
  <div class="page-container">
    <p class="eyebrow mb-6">History</p>

    <div class="grid gap-10 md:gap-14 md:grid-cols-2">
      {/* Experience column */}
      <div>
        <h2 class="text-xs font-mono uppercase tracking-[0.18em] text-ink-faint mb-5">
          Experience
        </h2>
        <ol class="space-y-7">
          {experience.map((item) => (
            <li>
              <div class="grid grid-cols-[auto_1fr] gap-4">
                <span class="font-mono text-xs text-ink-faint pt-0.5 whitespace-nowrap">
                  {item.start}–{String(item.end).slice(-2)}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-2.5">
                    {item.logo && (
                      <span class="shrink-0 inline-flex items-center justify-center h-7 w-7 rounded-md overflow-hidden border border-line bg-surface">
                        <img
                          src={item.logo}
                          alt={`${item.company} logo`}
                          class="h-full w-full object-contain"
                          loading="lazy"
                        />
                      </span>
                    )}
                    <div class="flex flex-wrap items-baseline gap-x-2 min-w-0">
                      <h3 class="text-base font-medium text-ink">{item.role}</h3>
                      <span class="text-ink-faint text-sm">·</span>
                      <p class="text-sm text-ink-muted">{item.company}</p>
                    </div>
                  </div>
                  {item.blurb && (
                    <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                      {item.blurb}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      {/* Education column */}
      <div>
        <h2 class="text-xs font-mono uppercase tracking-[0.18em] text-ink-faint mb-5">
          Education
        </h2>
        <ol class="space-y-7">
          {education.map((item) => (
            <li>
              <div class="grid grid-cols-[auto_1fr] gap-4">
                <span class="font-mono text-xs text-ink-faint pt-0.5 whitespace-nowrap">
                  {item.start}–{String(item.end).slice(-2)}
                </span>
                <div class="min-w-0">
                  <div class="flex items-center gap-2.5">
                    {item.logo && (
                      <span class="shrink-0 inline-flex items-center justify-center h-7 w-7 rounded-md overflow-hidden border border-line bg-surface">
                        <img
                          src={item.logo}
                          alt={`${item.shortName} logo`}
                          class="h-full w-full object-contain"
                          loading="lazy"
                        />
                      </span>
                    )}
                    <h3 class="text-base font-medium text-ink leading-snug">{item.school}</h3>
                  </div>
                  <p class="mt-2 text-sm text-ink-muted">
                    {item.degree}
                  </p>
                  {item.note && (
                    <p class="mt-1.5 text-sm text-ink-faint leading-relaxed">
                      {item.note}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
