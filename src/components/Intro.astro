---
import { site } from "../data/site";
---
<section id="about" class="pt-16 md:pt-24 pb-12 md:pb-16">
  <div class="page-container grid gap-8 md:gap-10 md:grid-cols-[260px_1fr] items-start">
    {/* Identity sidebar */}
    <aside class="md:sticky md:top-20">
      <div class="rounded-2xl border border-line bg-surface p-5">
        {/* Flip card: hero (now) ↔ baseball portrait (then) */}
        <div
          class="flip-card mb-4 aspect-square cursor-pointer select-none"
          tabindex="0"
          role="button"
          aria-label="Toggle photo: present and college days"
        >
          <div class="flip-card-inner relative h-full w-full">
            <div class="flip-card-face flip-card-front overflow-hidden rounded-xl border border-line bg-surface-2">
              <img
                src="/images/hero.jpg"
                alt="Portrait of EZ Chen"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="flip-card-face flip-card-back overflow-hidden rounded-xl border border-line bg-surface-2">
              <img
                src="/images/about-baseball-portrait.jpg"
                alt="EZ at bat for National Taiwan University, jersey #34"
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <h1 class="text-2xl font-semibold tracking-tight leading-tight">
          EZ Chen
        </h1>
        <p class="mt-2 text-sm text-ink-muted">
          {site.tagline}
        </p>
        <p class="mt-1 text-xs text-ink-faint font-mono">
          Based in {site.location}
        </p>
      </div>
    </aside>

    {/* Intro content */}
    <div class="md:pt-2">
      <p class="eyebrow mb-4">About</p>

      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight leading-tight text-ink max-w-2xl">
        {site.headline}
      </h2>

      <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-muted max-w-2xl">
        {site.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .flip-card {
    perspective: 1000px;
  }
  .flip-card-inner {
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform-style: preserve-3d;
  }
  .flip-card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card-back {
    transform: rotateY(180deg);
  }
  .flip-card:hover .flip-card-inner,
  .flip-card:focus .flip-card-inner,
  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

</style>

<script is:inline>
  // Click toggles persistent flip (helps mobile / touch where there is no hover)
  document.querySelectorAll('.flip-card').forEach((el) => {
    el.addEventListener('click', () => el.classList.toggle('is-flipped'));
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        el.classList.toggle('is-flipped');
      }
    });
  });
</script>
