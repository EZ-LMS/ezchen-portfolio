---
interface Props {
  title: string;
  description: string;
  year: number;
  tech: string[];
  demoUrl?: string;
  demoNote?: string;
  repoUrl: string;
  thumbnail: string;
}

const { title, description, year, tech, demoUrl, demoNote, repoUrl, thumbnail } = Astro.props;
const primaryHref = demoUrl ?? repoUrl;
---
<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-all hover:border-line-strong hover:-translate-y-0.5 hover:shadow-[0_10px_40px_-15px_rgba(31,31,35,0.12)]">
  <a
    href={primaryHref}
    target="_blank"
    rel="noopener noreferrer"
    class="block aspect-[1200/630] overflow-hidden border-b border-line bg-surface-2"
    aria-label={`Open ${title}`}
  >
    <img
      src={thumbnail}
      alt={`${title} screenshot`}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="lazy"
    />
  </a>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-base font-medium text-ink">
        <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 decoration-dust-purple decoration-2">
          {title}
        </a>
      </h3>
      <span class="text-xs font-mono text-ink-faint shrink-0">{year}</span>
    </div>

    <p class="text-sm text-ink-muted leading-relaxed">{description}</p>

    <ul class="mt-1 flex flex-wrap gap-1.5">
      {tech.map((t) => (
        <li class="font-mono text-[11px] tracking-tight text-ink-muted bg-surface-2 border border-line rounded-md px-2 py-0.5">
          {t}
        </li>
      ))}
    </ul>

    <div class="mt-auto pt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-ink hover:text-ink/70"
        >
          Demo
          <span aria-hidden="true" class="text-ink-faint">↗</span>
        </a>
      )}
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-ink-muted hover:text-ink"
      >
        Code
        <span aria-hidden="true" class="text-ink-faint">↗</span>
      </a>
      {demoNote && (
        <span class="text-xs text-ink-faint ml-auto">{demoNote}</span>
      )}
    </div>
  </div>
</article>
