---
interface Props {
  title: string;
  description: string;
  year: number;
  tech: string[];
  demoUrl?: string;
  demoNote?: string;
  repoUrl?: string;
  thumbnail: string;
}

const { title, description, year, tech, demoUrl, demoNote, repoUrl, thumbnail } = Astro.props;
const primaryHref = demoUrl ?? repoUrl ?? "#";
---
<article class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-surface transition-all hover:border-line-strong hover:-translate-y-0.5 hover:shadow-[0_10px_30px_-15px_rgba(31,31,35,0.15)]">
  <a
    href={primaryHref}
    target="_blank"
    rel="noopener noreferrer"
    class="block aspect-[1200/630] overflow-hidden border-b border-line bg-surface-2"
    aria-label={`Open ${title}`}
  >
    <img
      src={thumbnail}
      alt={`${title} screenshot`}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="lazy"
    />
  </a>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="text-sm font-medium text-ink">
        <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4 decoration-dust-purple decoration-2">
          {title}
        </a>
      </h3>
      <span class="text-[11px] font-mono text-ink-faint shrink-0">{year}</span>
    </div>

    <p class="text-xs text-ink-muted leading-relaxed">{description}</p>

    <ul class="mt-auto pt-2 flex flex-wrap gap-1">
      {tech.map((t) => (
        <li class="font-mono text-[10px] tracking-tight text-ink-muted bg-surface-2 border border-line rounded px-1.5 py-0.5">
          {t}
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs pt-1">
      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-ink hover:text-ink/70"
        >
          Demo<span aria-hidden="true" class="text-ink-faint">↗</span>
        </a>
      )}
      {repoUrl && (
        <a
          href={repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-ink-muted hover:text-ink"
        >
          Code<span aria-hidden="true" class="text-ink-faint">↗</span>
        </a>
      )}
      {demoNote && (
        <span class="text-[10px] text-ink-faint ml-auto italic">{demoNote}</span>
      )}
    </div>
  </div>
</article>
