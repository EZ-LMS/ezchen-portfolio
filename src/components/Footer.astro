---
import { site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="border-t border-line py-10">
  <div class="page-container flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-ink-faint font-mono">
    <p>© {year} {site.fullName}</p>
    <p>
      Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-ink underline-offset-4 hover:underline">Astro</a>
      · Typeset in Geist
    </p>
  </div>
</footer>
